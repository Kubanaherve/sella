{
  "_meta": {
    "title": "Sella East African Commerce & UX Localization Standard",
    "description": "Standardized, everyday market terminology across Sella's 6 core East African commercial languages. Prioritizes natural cashier/shopkeeper usage (MTN MoMo, M-Pesa, Lumicash, Airtel Money, Android/WhatsApp style) over academic textbook purism.",
    "supported_languages": {
      "rw": "Ikinyarwanda (Rwanda - Kigali daily market standard)",
      "sw": "Kiswahili (East African Common Market - DRC, Kenya, Tanzania, Uganda, Rwanda)",
      "rn": "Ikirundi (Burundi - Bujumbura Lumicash/Ecocash retail standard)",
      "lg": "Luganda (Uganda - Kampala downtown / MoMo Uganda commercial standard)",
      "fr": "Français (Regional Commercial French - Goma, Bukavu, Bujumbura, Kigali)",
      "en": "English (International Retail / Global Counter standard)"
    },
    "core_principles": [
      "No academic or archaic purisms (e.g. never use 'gukurura dosiye', 'okutikkula', 'indebero', 'imirasire').",
      "Action buttons must be concise, personalized 1-word imperative verbs (e.g. Injira, Ingia, Yingira, Connexion, Log in).",
      "Adopt natural Kinyarwandized/Swahilized loanwords (Kudownloadinga, Kuprinta, Guscaninga, Kurefresha) where formal terms confuse shopkeepers.",
      "Global technical and payment protocols stay untouched (PIN, QR, Wi-Fi, Bluetooth, SMS, OTP, MoMo, Airtel Money, M-Pesa).",
      "Financial amounts are displayed in whole currency units with explicit local currency labels (RWF, BIF, UGX, KES, TZS, USD)."
    ]
  },
