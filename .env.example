# ---------------------------------------------------------------------------
# Data mode: local | cloud
# ---------------------------------------------------------------------------
VITE_DATA_MODE=cloud

# ---------------------------------------------------------------------------
# Supabase (public)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Prefer new publishable key (sb_publishable_...) or legacy anon JWT
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Prefer new secret key (sb_secret_...) or legacy service_role JWT
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
SUPABASE_ANON_KEY=sb_publishable_xxx

# ---------------------------------------------------------------------------
# Plans (RWF)
# ---------------------------------------------------------------------------
VITE_PLAN_PRICE_MONTHLY_RWF=5000
VITE_PLAN_PRICE_ANNUAL_RWF=50000
VITE_TRIAL_DAYS=7
VITE_APP_URL=http://127.0.0.1:5173
VITE_BILLING_URL=http://127.0.0.1:5173/subscribe

# Manual merchant payout details (shown in-app) — replace XXX placeholders
VITE_BANK_NAME=Bank of Kigali (BK)
VITE_BANK_ACCOUNT_NAME=Sella
VITE_BANK_ACCOUNT_NUMBER=000XXXXXXX
VITE_BANK_SWIFT=BKIGRWRW
VITE_MOMO_MERCHANT_NAME=Sella
VITE_MOMO_MERCHANT_CODE=*182*8*1#
VITE_MOMO_MERCHANT_PHONE=+2507XXXXXXXX
VITE_AIRTEL_MERCHANT_NAME=Sella
VITE_AIRTEL_MERCHANT_CODE=*500*1#
VITE_AIRTEL_MERCHANT_PHONE=+2507XXXXXXXX

# ---------------------------------------------------------------------------
# Email (free options)
# 1) Supabase Auth → Project Settings → Auth → SMTP (built-in free tier, rate-limited)
# 2) Resend.com free tier (~100 emails/day) — recommended for shop-code welcome mail
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Sella <onboarding@resend.dev>

# ---------------------------------------------------------------------------
# WhatsApp OTP (Edge Function secrets)
# ---------------------------------------------------------------------------
WHATSAPP_PROVIDER=meta
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
# Or Twilio:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ---------------------------------------------------------------------------
# Paypack Rwanda MoMo (instant STK for MTN + Airtel)
# Dashboard: https://paypack.rw — create app, copy Client ID/Secret, set webhook
# Webhook URL: https://YOUR_PROJECT_REF.supabase.co/functions/v1/paypack-webhook
# ---------------------------------------------------------------------------
PAYPACK_CLIENT_ID=
PAYPACK_CLIENT_SECRET=
PAYPACK_WEBHOOK_SECRET=
PAYPACK_ENV=production

# ---------------------------------------------------------------------------
# Flutterwave (Visa / Mastercard + optional MoMo)
# Dashboard: https://dashboard.flutterwave.com → Settings → API
# Webhook URL: https://YOUR_PROJECT_REF.supabase.co/functions/v1/flutterwave-webhook
# Set FLW_WEBHOOK_SECRET to the same verif-hash you configure in Flutterwave
# ---------------------------------------------------------------------------
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_ENCRYPTION_KEY=
FLW_WEBHOOK_SECRET=
APP_URL=http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Apple IAP
# ---------------------------------------------------------------------------
APPLE_BUNDLE_ID=com.sella.app
APPLE_SHARED_SECRET=
APPLE_PRODUCT_ID_MONTHLY=sella_monthly_5000
APPLE_PRODUCT_ID_ANNUAL=sella_annual_50000

# Store reviewer WhatsApp demo (+250780000000 / OTP 123456) — ONLY when true
ENABLE_REVIEWER_BYPASS=false
